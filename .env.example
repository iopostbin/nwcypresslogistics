# NW Cypress Referral API – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Allowed CORS origin (use * for development, your domain in production)
ALLOWED_ORIGIN=http://localhost:5500

# ── Referral Links ────────────────────────────────────────────────────────────
# Base URL for generated referral links
REFERRAL_BASE_URL=https://nwcypresslogistics.com/ref

# ── Email Notifications (optional) ───────────────────────────────────────────
# Leave SMTP_HOST blank to disable email notifications (requests are still logged).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="NW Cypress Referral" <your-email@example.com>

# Email address that receives new referral link request notifications
NOTIFY_EMAIL=contact@nwcypresslogistics.com
